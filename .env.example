# ---- This is an example, create your own .env file or just rename this file to .env -----

# Fill owner & moderator using your own number, separate the numbers using coma, for example: 628123456789, 628987654321
# You dont need to fill the moderator, it's optional. only used for plugins that have (plugins.mods = true)
OWNER=
MODERATOR=

# Support mongodb/MySql2/Local file sql
# • mongodb+srv://...
# • mysql://...
# • dont fill it to use local file sql
DATABASE=

# AI Agent
#__________________________________________________
AI_PERSONALITY=

# Gemini API Key (Free, Get from https://aistudio.google.com)
# Accepts single string or Array for fallback. Array Example: ["Key1", "Key2"]
AI_KEYS=

# Discord (optional, if you want run the discord bot too). — https://discord.com/developers/home
#__________________________________________________
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_OWNER=

# Github (optional)
#__________________________________________________

GIT_CLASSIC_KEY=
GIT_TOKEN=
GIT_USER=
GIT_EMAIL=
GIT_REPO=

# Tunnel / Custom domain (optional)
#__________________________________________________
# See README.md -> "About Website" for full explanation of each scenario.

CF_KV_TOKEN=
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=

CF_TOKEN=
CF_HOSTNAME=

HOSTNAME_PUBLIC=